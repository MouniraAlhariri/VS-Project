@page
@model IndexModel
@{
    ViewData["Title"] = "Mounira Alhariri | Creative Hub";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    
    <!-- Custom Advanced Styling -->
    <style>
        :root {
            --neon-pink: #ff2a74;
            --neon-blue: #05d9e8;
            --neon-purple: #9d4edd;
            --glass-bg: rgba(15, 12, 30, 0.65);
            --glass-border: rgba(255, 255, 255, 0.08);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: #080511;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow-x: hidden;
            perspective: 1000px;
            padding: 40px 20px;
        }

        /* Ambient Canvas Background Layer */
        #bg-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            pointer-events: none;
        }

        /* Glassmorphism Main Card */
        .glass-card {
            max-width: 850px;
            width: 100%;
            background: var(--glass-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 30px;
            padding: 50px 30px;
            text-align: center;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7),
                        0 0 40px rgba(5, 217, 232, 0.05);
            transform-style: preserve-3d;
            transition: border-color 0.5s;
        }

        .glass-card:hover {
            border-color: rgba(5, 217, 232, 0.2);
        }

        /* Premium Heading Typography */
        h1 {
            font-size: 3.5rem;
            font-weight: 900;
            letter-spacing: -1px;
            line-height: 1.2;
            margin-bottom: 8px;
            cursor: default;
            display: inline-block;
            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            transition: transform 0.1s linear;
            will-change: transform, filter;
        }

        .subtitle {
            font-size: 1rem;
            color: #a39fbc;
            text-transform: uppercase;
            letter-spacing: 4px;
            margin-bottom: 40px;
            font-weight: 600;
        }

        /* Sleek Video Frame with Soft Glow */
        .video-wrapper {
            position: relative;
            width: 100%;
            padding-bottom: 56.25%; /* Perfect 16:9 Aspect Ratio */
            height: 0;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
            background: #000;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .video-wrapper iframe {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border: 0;
        }

        /* Aesthetic Footer */
        footer {
            margin-top: 40px;
            font-size: 0.85rem;
            color: #6a648a;
            letter-spacing: 1px;
        }

        footer strong {
            color: var(--neon-blue);
            font-weight: 600;
        }

        /* Responsive scaling for smaller screens */
       @@media (max-width: 600px) {
            h1 { font-size: 2.3rem; }
            .subtitle { font-size: 0.8rem; letter-spacing: 2px; }
            .glass-card { padding: 30px 15px; }
        }
    </style>
</head>
<body>

    <!-- Animated Particle Canvas Context -->
    <canvas id="bg-canvas"></canvas>

    <!-- Main Glassmorphic Panel -->
    <div class="glass-card">
        <!-- High-End JavaScript Animated Heading -->
        <h1 id="loop-headline">Mounira Alhariri</h1>
        <p class="subtitle">Sound & Aesthetic Space</p>

        <!-- Premium Embedded Video Container -->
        <div class="video-wrapper">
            <iframe src="https://www.youtube.com/embed/4NRXx6U8ABQ?autoplay=0&mute=0&modestbranding=1&rel=0" 
                    title="YouTube video player" 
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                    allowfullscreen>
            </iframe>
        </div>

        <footer>
            Designed Digitally For <strong>Mounira Alhariri</strong> &bull; @DateTime.Now.Year
        </footer>
    </div>

    <!-- Interactive & Looping JavaScript Elements -->
    <script>
        /* --- 1. THE ADVANCED H1 LOOP ANIMATION --- */
        const headline = document.getElementById('loop-headline');
        let degree = 0;
        let scaleTime = 0;

        function renderHeadingLoop() {
            scaleTime += 0.03;
            degree = (degree + 0.8) % 360;

            // Math.sin loops values perfectly between -1 and 1
            const pulseScale = 1 + Math.sin(scaleTime) * 0.03; 
            const floatTranslate = Math.sin(scaleTime * 0.7) * 4; 
            const dynamicGlow = 12 + Math.sin(scaleTime) * 8;

            // Compute dynamic dual neon colors cycling via HSL
            const color1 = `hsl(${degree}, 100%, 65%)`;
            const color2 = `hsl(${(degree + 60) % 360}, 100%, 60%)`;
            const glowColor = `hsl(${degree}, 95%, 55%)`;

            // Inject complex aesthetics straight to the elements DOM inline styles
            headline.style.backgroundImage = `linear-gradient(135deg, ${color1}, ${color2})`;
            headline.style.filter = `drop-shadow(0 0 ${dynamicGlow}px ${glowColor})`;
            headline.style.transform = `scale(${pulseScale}) translateY(${floatTranslate}px)`;

            requestAnimationFrame(renderHeadingLoop);
        }
        renderHeadingLoop();


        /* --- 2. AMBIENT BACKGROUND PARTICLES LOOP --- */
        const canvas = document.getElementById('bg-canvas');
        const ctx = canvas.getContext('2d');
        let particles = [];

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        // Generate coordinates for ambient star/particle field
        for(let i = 0; i < 65; i++) {
            particles.push({
                x: Math.random() * canvas.width,
                y: Math.random() * canvas.height,
                radius: Math.random() * 2 + 0.5,
                speedY: -(Math.random() * 0.4 + 0.1),
                alpha: Math.random() * 0.6 + 0.1,
                fadeDirection: Math.random() > 0.5 ? 0.005 : -0.005
            });
        }

        function drawBackgroundLoop() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            
            for(let p of particles) {
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                ctx.fillStyle = `rgba(5, 217, 232, ${p.alpha})`; // Ethereal Cyan Cyan Glow
                ctx.fill();

                // Move particle upwards smoothly
                p.y += p.speedY;
                if (p.y < -10) p.y = canvas.height + 10;

                // Loop the opacity breathing effect
                p.alpha += p.fadeDirection;
                if(p.alpha > 0.7 || p.alpha < 0.1) p.fadeDirection *= -1;
            }
            requestAnimationFrame(drawBackgroundLoop);
        }
        drawBackgroundLoop();
    </script>
</body>
</html>